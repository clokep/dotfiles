# Wrapper function to launch Claude and either create a new session for the branch
# or resume a past session based on the branch name
#
# Originally from https://gist.github.com/rcscott/e6e9005f39e571d940a9294e7d0ea1e2
function c() {
  local name=$(git branch --show-current)

  if [[ "$name" == "main" ]]; then
    claude
    return
  fi

  local encoded=$(pwd | sed 's|[^a-zA-Z0-9]|-|g')
  local sessions_dir="$HOME/.claude/projects/$encoded"
  local found=false

  if [ -d "$sessions_dir" ]; then
    for jsonl in "$sessions_dir"/*.jsonl; do
      local last_title=$(grep '"type":"custom-title"' "$jsonl" | tail -1 | jq -r '.customTitle')
      if [[ "$last_title" == "$name" ]]; then
        found=true
        break
      fi
    done
  fi

  if $found; then
    claude --resume "$name"
  else
    claude "/rename $name"
  fi
}

# Function to list all known Claude sessions for a path
function claude-sessions() {
  local encoded=$(pwd | sed 's|[^a-zA-Z0-9]|-|g')
  local sessions_dir="$HOME/.claude/projects/$encoded"

  if [ -d "$sessions_dir" ]; then
    for jsonl in "$sessions_dir"/*.jsonl; do
      local title=$(grep '"type":"custom-title"' "$jsonl" | tail -1 | jq -r '.customTitle')
      if [[ "$title" != "" ]]; then
        echo $title
      fi
    done
  fi
}

# Wrapper function to launch OpenCode and either create a new session for the branch
# or resume a past session based on the branch name
function oc() {
  local name=$(git branch --show-current)

  if [[ "$name" == "main" ]]; then
    opencode
    return
  fi

  session_id=$(opencode session list --format json | jq -r --arg name "$name" '[.[] | select(.title == $name)][0]  | .id')

  if [ -n "$session_id" ]; then
    echo "REUSING $session_id"
    opencode --session "$session_id"
  else
    echo "NEW SESSION $name"
    opencode --prompt "/session_rename $name"
  fi
}
