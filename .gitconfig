[core]
	autocrlf = false
	ignorecase = true
[user]
	name = Patrick Cloke
	email = clokep@patrick.cloke.us
	signingkey = 33FC58F6A7113048
[color]
	ui = auto
[diff]
	compactionHeuristic = true
[alias]
# Log of changes on origin not yet on branch (aka hg incoming).
	incoming = log HEAD..@{upstream}
# Log of changes on branch not yet on branch (aka hg outgoing).
	outgoing = log @{upstream}..HEAD
	graph = log --pretty=oneline --abbrev-commit --decorate --graph
	diffstat = diff --stat
	staged = diff --cached
	unstaged = diff
	uadd = add --update
# Commit even if pre-commit hooks fail.
	reallycommit = commit --no-verify
# Amend with the same commit message.
	fixup = commit --amend --no-edit
	reallyfixup = commit --no-verify --amend --no-edit
# Push even if pre-push hooks fail.
	reallypush = push --no-verify
# Print out aliases
	alias = config --get-regexp '^alias\\.'
# Print like hg rollback
	rollback = reset --soft HEAD^
	committers = shortlog -sne
# Import like hg import
	import = apply --reject
# Show a diff of edits to existing files (no adds, deletes or renames), ignoring whitespace.
	modified = diff -w --diff-filter=MUB
	mstaged = diff -w --cached --diff-filter=MUB
# Print the root of this git repository.
	root = rev-parse --show-toplevel
# Run git through git, so a stray leading `git` still works.
	git = !git
	mylog = log --author='Patrick Cloke'
# Delete local branches whose upstream branch is gone, even if they are unmerged.
	localprune = !git for-each-ref --format '%(refname:short) %(upstream:track)' refs/heads | awk '$2 == \"[gone]\" {print $1}' | xargs git branch --delete --force

# Some things I always try to type...
	branches = branch -l
	tags = tag -l
# Squash the commits since the merge-base with a branch or commit (default main) into one,
# then edit the combined message.
	squash = "!f() { base=$(git merge-base \"${1:-main}\" HEAD) && msg=$(git log --reverse --format=%B \"$base\"..HEAD) && git reset --soft \"$base\" && git commit -e -m \"$msg\"; }; f"
# Diff, log and interactively rebase the commits on this branch since it left main.
# For a branch stacked on another branch, run git diff <parent>...HEAD directly.
	branchdiff = diff main...HEAD
	branchlog = log main..HEAD
	branchbase = !git rebase -i $(git merge-base main HEAD)
# Bisect the current branch using a command.
	branchsect = "!f() { git bisect start HEAD \"$(git merge-base main HEAD)\"; git bisect run \"$@\"; }; f"
# Make a commit with a hard-coded message.
	news = commit -m Newsfragment
[push]
	default = simple
[log]
	mailmap = true
[pull]
	rebase = false
[init]
	defaultBranch = main
[rerere]
	enabled = true
[help]
	autocorrect = prompt
[include]
	# Include a local configuration, this gets ignored if the file doesn't exist.
	path = .gitconfig.local
