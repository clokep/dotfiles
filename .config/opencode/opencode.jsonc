{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["superpowers@git+https://github.com/obra/superpowers.git"],

  // Format files after write/edit/patch using detected project formatters.
  "formatter": true,

  // Don't flag build/test output as filesystem changes.
  "watcher": {
    "ignore": ["dist/**", "build/**", "coverage/**", "obj-dir*/**", "__pycache__/**"]
  },

  // Ask before any shell command, then allow the read-only commands below.
  // Last matching rule wins: broad `ask` first, then allows, then hard denies.
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },

    // read-only navigation & search
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "pwd", "effect": "allow" },
    { "action": "shell", "resource": "file *", "effect": "allow" },
    { "action": "shell", "resource": "stat *", "effect": "allow" },
    { "action": "shell", "resource": "tree *", "effect": "allow" },
    { "action": "shell", "resource": "du *", "effect": "allow" },
    { "action": "shell", "resource": "df *", "effect": "allow" },
    { "action": "shell", "resource": "which *", "effect": "allow" },
    { "action": "shell", "resource": "whoami", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "sort *", "effect": "allow" },
    { "action": "shell", "resource": "uniq *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "jq *", "effect": "allow" },
    { "action": "shell", "resource": "diff *", "effect": "allow" },

    // read-only git
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git range-diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git grep *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git branch --list", "effect": "allow" },
    { "action": "shell", "resource": "git merge-base *", "effect": "allow" },
    { "action": "shell", "resource": "git reflog *", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-tree *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-remote *", "effect": "allow" },
    { "action": "shell", "resource": "git blame *", "effect": "allow" },
    { "action": "shell", "resource": "git describe *", "effect": "allow" },
    { "action": "shell", "resource": "git verify-commit *", "effect": "allow" },
    { "action": "shell", "resource": "git verify-pack *", "effect": "allow" },
    { "action": "shell", "resource": "git verify-tag *", "effect": "allow" },

    // build & test (no `run`/`exec` — those prompt)
    // Python
    { "action": "shell", "resource": "pytest *", "effect": "allow" },
    { "action": "shell", "resource": "python -m pytest *", "effect": "allow" },
    { "action": "shell", "resource": "python manage.py test *", "effect": "allow" },
    { "action": "shell", "resource": "trial *", "effect": "allow" },
    { "action": "shell", "resource": "python -m twisted.trial *", "effect": "allow" },
    { "action": "shell", "resource": "mypy *", "effect": "allow" },
    { "action": "shell", "resource": "python -m flake8 *", "effect": "allow" },
    { "action": "shell", "resource": "flake8 *", "effect": "allow" },
    { "action": "shell", "resource": "ruff *", "effect": "allow" },
    // dotnet
    { "action": "shell", "resource": "dotnet build *", "effect": "allow" },
    { "action": "shell", "resource": "dotnet test *", "effect": "allow" },
    // node
    { "action": "shell", "resource": "npm ci", "effect": "allow" },

    // read-only gh
    { "action": "shell", "resource": "gh issue list *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue status *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue view *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr list *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr status *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr checks *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr diff *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr view *", "effect": "allow" },
    { "action": "shell", "resource": "gh run list *", "effect": "allow" },
    { "action": "shell", "resource": "gh run view *", "effect": "allow" },
    { "action": "shell", "resource": "gh run watch *", "effect": "allow" },

    // read-only Bugzilla (python-bugzilla); `new`/`modify`/`attach`/`login` prompt
    { "action": "shell", "resource": "bugzilla query *", "effect": "allow" },
    { "action": "shell", "resource": "bugzilla info *", "effect": "allow" },

    // moz-phab for phabricator
    { "action": "shell", "resource": "moz-phab doctor *", "effect": "allow" },
    { "action": "shell", "resource": "moz-phab list *", "effect": "allow" },
    { "action": "shell", "resource": "moz-phab patch *", "effect": "allow" },
    { "action": "shell", "resource": "moz-phab version *", "effect": "allow" },

    // allow viewing package information
    { "action": "shell", "resource": "pip freeze *", "effect": "allow" },
    { "action": "shell", "resource": "pip list *", "effect": "allow" },
    { "action": "shell", "resource": "pip show *", "effect": "allow" },
    { "action": "shell", "resource": "poetry about *", "effect": "allow" },
    { "action": "shell", "resource": "poetry check *", "effect": "allow" },
    { "action": "shell", "resource": "poetry show *", "effect": "allow" },

    // never allow installing packages.
    { "action": "shell", "resource": "brew install *", "effect": "deny" },
    { "action": "shell", "resource": "pip install *", "effect": "deny" },
    { "action": "shell", "resource": "pipx install *", "effect": "deny" },
    { "action": "shell", "resource": "poetry add *", "effect": "deny" },
    { "action": "shell", "resource": "poetry install *", "effect": "deny" },
    { "action": "shell", "resource": "poetry sync *", "effect": "deny" },
    { "action": "shell", "resource": "uv install *", "effect": "deny" },
    { "action": "shell", "resource": "npm install *", "effect": "deny" },

    // hard denies — last match wins, so these override everything above
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    { "action": "shell", "resource": "rm -fr *", "effect": "deny" },
    { "action": "shell", "resource": "git push --force *", "effect": "deny" },
    { "action": "shell", "resource": "git push -f *", "effect": "deny" },

    { "action": "read", "resource": ".env*", "effect": "deny" },
    { "action": "read", "resource": "*", "effect": "allow" }
  ]
}
